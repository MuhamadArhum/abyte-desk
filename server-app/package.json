{
  "name": "abyte-erp-server",
  "version": "1.0.3",
  "description": "AByte ERP Server - Local LAN Server Manager",
  "main": "main.js",
  "repository": "https://github.com/MuhamadArhum/abyte-desk",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "mysql2": "^3.23.4",
    "node-os-utils": "^1.3.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.abytesolutions.erp-server",
    "productName": "AByte ERP Server",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AByte ERP Server",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "SETUP_GUIDE.txt",
      "installer.nsh"
    ],
    "extraResources": [
      {
        "from": "../main-app/backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!tests/**",
          "!*.test.js",
          "!.env*",
          "!backups/**"
        ]
      },
      {
        "from": "../main-app/frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../database/schema.sql",
        "to": "schema.sql"
      }
    ],
    "extraFiles": [
      {
        "from": "../main-app/backend/node_modules",
        "to": "resources/backend/node_modules"
      }
    ]
  }
}
